# ================================================
# KEEP THESE FILES (Important source code):
# ================================================
# ✅ Core/Inc/*.h, Core/Inc/*.hpp
# ✅ Core/Src/*.c, Core/Src/*.cpp  
# ✅ TouchGFX/gui/include/**
# ✅ TouchGFX/gui/src/**
# ✅ TouchGFX/assets/texts/texts.json
# ✅ TouchGFX/*.touchgfx
# ✅ TouchGFX/target/*.cpp, TouchGFX/target/*.hpp
# ✅ *.ioc files
# ✅ Linker scripts (*.ld)
# ✅ README.md, documentation files
# ✅ This .gitignore file
# ================================================